{
  "name": "nova-admin-template",
  "version": "0.1.0",
  "description": "A lightweight Vue 3 admin template based on Vben Admin.",
  "private": true,
  "keywords": [
    "admin-template",
    "element-plus",
    "typescript",
    "vite",
    "vue3"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "pnpm -F @nova/admin run build",
    "build:analyze": "pnpm -F @nova/admin run build:analyze",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "check": "pnpm run check:type && pnpm run lint",
    "check:circular": "vsh check-circular",
    "check:dep": "vsh check-dep",
    "check:type": "pnpm -F @nova/admin run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "dev": "pnpm -F @nova/admin run dev",
    "dev:mock": "pnpm -F @vben/backend-mock run start",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "pnpm -r run --if-present stub",
    "preview": "pnpm -F @nova/admin run preview",
    "template:init": "node ./scripts/setup-template.mjs",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --dom"
  },
  "devDependencies": {
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxfmt-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.21.0"
}
