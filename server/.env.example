WEAVEPRESS_APP_NAME=weavepress
WEAVEPRESS_APP_ENV=local
WEAVEPRESS_HTTP_ADDR=:8080
WEAVEPRESS_LOG_LEVEL=info

WEAVEPRESS_DATABASE_ENABLED=true
WEAVEPRESS_DATABASE_DRIVER=mysql
WEAVEPRESS_DATABASE_DSN=weavepress:weavepress_pass@tcp(127.0.0.1:3306)/weavepress
WEAVEPRESS_DATABASE_MAX_OPEN_CONNS=25
WEAVEPRESS_DATABASE_MAX_IDLE_CONNS=5
WEAVEPRESS_DATABASE_CONN_MAX_LIFETIME=30m
WEAVEPRESS_DATABASE_CONN_MAX_IDLE_TIME=5m
WEAVEPRESS_DATABASE_PING_TIMEOUT=3s

WEAVEPRESS_REDIS_ENABLED=true
WEAVEPRESS_REDIS_ADDR=127.0.0.1:6379
WEAVEPRESS_REDIS_USERNAME=
WEAVEPRESS_REDIS_PASSWORD=
WEAVEPRESS_REDIS_DB=0
WEAVEPRESS_REDIS_DIAL_TIMEOUT=3s
WEAVEPRESS_REDIS_READ_TIMEOUT=2s
WEAVEPRESS_REDIS_WRITE_TIMEOUT=2s
WEAVEPRESS_REDIS_PING_TIMEOUT=2s
WEAVEPRESS_REDIS_POOL_SIZE=10
WEAVEPRESS_REDIS_MIN_IDLE_CONNS=2
WEAVEPRESS_REDIS_KEY_PREFIX=weavepress:local

WEAVEPRESS_WORKER_ENABLED=false
WEAVEPRESS_WORKER_CONCURRENCY=4
WEAVEPRESS_WORKER_SHUTDOWN_TIMEOUT=10s

WEAVEPRESS_AUTH_JWT_SECRET=local-development-jwt-secret-change-me
WEAVEPRESS_AUTH_ACCESS_TTL=15m
WEAVEPRESS_AUTH_REFRESH_TTL=720h
WEAVEPRESS_AUTH_REFRESH_COOKIE=wp_refresh_token
WEAVEPRESS_AUTH_COOKIE_SECURE=false
WEAVEPRESS_AUTH_MEDIA_SIGNING_KEY=local-development-media-signing-key
WEAVEPRESS_AUTH_MEDIA_URL_TTL=10m

WEAVEPRESS_STORAGE_DRIVER=local
WEAVEPRESS_STORAGE_LOCAL_DIR=./data
WEAVEPRESS_STORAGE_QINIU_ACCESS_KEY=
WEAVEPRESS_STORAGE_QINIU_SECRET_KEY=
WEAVEPRESS_STORAGE_QINIU_BUCKET=
WEAVEPRESS_STORAGE_QINIU_DOMAIN=

WEAVEPRESS_COLLECTOR_PAGE_MAX_BYTES=10485760
WEAVEPRESS_COLLECTOR_IMAGE_MAX_BYTES=15728640
WEAVEPRESS_COLLECTOR_ARTICLE_MAX_BYTES=104857600
WEAVEPRESS_COLLECTOR_MAX_IMAGES=100
WEAVEPRESS_COLLECTOR_REQUEST_TIMEOUT=30s
WEAVEPRESS_COLLECTOR_IMAGE_TIMEOUT=30s
WEAVEPRESS_COLLECTOR_IMAGE_CONCURRENCY=4
WEAVEPRESS_COLLECTOR_MAX_REDIRECTS=5
WEAVEPRESS_COLLECTOR_USER_AGENT=Mozilla/5.0 (compatible; WeavePress/1.0)

WEAVEPRESS_OBSERVABILITY_METRICS_ENABLED=true
WEAVEPRESS_OBSERVABILITY_METRICS_PATH=/metrics
WEAVEPRESS_OBSERVABILITY_METRICS_NAMESPACE=weavepress
WEAVEPRESS_OBSERVABILITY_TRACING_ENABLED=false
WEAVEPRESS_OBSERVABILITY_TRACING_EXPORTER=stdout
WEAVEPRESS_OBSERVABILITY_TRACING_ENDPOINT=localhost:4317
WEAVEPRESS_OBSERVABILITY_TRACING_INSECURE=true
WEAVEPRESS_OBSERVABILITY_TRACING_SAMPLE_RATIO=1.0
