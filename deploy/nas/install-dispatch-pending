#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly INSTALL_ROOT="/volume1/docker/weavepress-git"
readonly BARE_REPO="$INSTALL_ROOT/WeavePress.git"
readonly STATE_DIR="$INSTALL_ROOT/release-state"
readonly BIN_DIR="$INSTALL_ROOT/bin"
readonly DISPATCHER="$BIN_DIR/dispatch-pending"

hook_temp=""
dispatcher_temp=""

cleanup() {
  [[ -z "$hook_temp" ]] || rm -f -- "$hook_temp"
  [[ -z "$dispatcher_temp" ]] || rm -f -- "$dispatcher_temp"
}
trap cleanup EXIT

die() {
  printf 'install-dispatch-pending: %s\n' "$1" >&2
  exit 1
}

[[ $# -eq 1 ]] || die 'expected checked-out WeavePress repository root'
source_root="$1"
for command in git install mktemp stat; do
  command -v "$command" >/dev/null 2>&1 || die "required command is missing: ${command}"
done
[[ -d "$source_root" && ! -L "$source_root" ]] || die 'checked-out repository root is missing or unsafe'
[[ -d "$BARE_REPO" && ! -L "$BARE_REPO" ]] || die 'WeavePress bare repository is missing or unsafe'
[[ -d "$BARE_REPO/hooks" && ! -L "$BARE_REPO/hooks" ]] || die 'bare repository hooks directory is missing or unsafe'
[[ "$(git --git-dir="$BARE_REPO" rev-parse --is-bare-repository 2>/dev/null)" == true ]] || \
  die 'WeavePress repository is not a valid bare repository'
[[ -f "$source_root/deploy/nas/post-receive" && ! -L "$source_root/deploy/nas/post-receive" ]] || \
  die 'source post-receive hook is missing or unsafe'
[[ -f "$source_root/deploy/nas/dispatch-pending" && ! -L "$source_root/deploy/nas/dispatch-pending" ]] || \
  die 'source pending dispatcher is missing or unsafe'

install -d -m 0700 "$STATE_DIR" "$BIN_DIR"
hook_temp="$(mktemp "$BARE_REPO/hooks/.post-receive.XXXXXX")" || die 'could not stage post-receive hook'
dispatcher_temp="$(mktemp "$BIN_DIR/.dispatch-pending.XXXXXX")" || die 'could not stage pending dispatcher'
install -m 0700 "$source_root/deploy/nas/post-receive" "$hook_temp"
install -m 0700 "$source_root/deploy/nas/dispatch-pending" "$dispatcher_temp"
mv -f -- "$hook_temp" "$BARE_REPO/hooks/post-receive"
hook_temp=""
mv -f -- "$dispatcher_temp" "$DISPATCHER"
dispatcher_temp=""

for directory in "$STATE_DIR" "$BIN_DIR"; do
  [[ -d "$directory" && ! -L "$directory" ]] || die 'installed directory is missing or unsafe'
  [[ "$(stat -c '%a' -- "$directory")" == 700 ]] || die 'installed directory mode must be 0700'
done
for program in "$BARE_REPO/hooks/post-receive" "$DISPATCHER"; do
  [[ -f "$program" && ! -L "$program" && -x "$program" ]] || die 'installed program is missing or unsafe'
  [[ "$(stat -c '%a' -- "$program")" == 700 ]] || die 'installed program mode must be 0700'
done

printf '%s\n' 'Installed and verified WeavePress direct-dispatch hook, state, and dispatcher.'
