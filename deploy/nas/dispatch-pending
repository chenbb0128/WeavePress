#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly GIT_DIR="/volume1/docker/weavepress-git/WeavePress.git"
readonly POST_RECEIVE="$GIT_DIR/hooks/post-receive"
readonly DISPATCH_TIMEOUT_SECONDS=55
export GIT_DIR

case "${1:-}" in
  --hook) mode=hook ;;
  --scheduled) mode=scheduled ;;
  *)
    printf 'Usage: %s --hook|--scheduled\n' "$0" >&2
    exit 64
    ;;
esac
[[ $# -eq 1 ]] || exit 64
[[ -x "$POST_RECEIVE" && ! -L "$POST_RECEIVE" ]] || {
  printf 'dispatch-pending: installed post-receive hook is missing or unsafe\n' >&2
  exit 1
}
exec timeout "$DISPATCH_TIMEOUT_SECONDS" "$POST_RECEIVE" --dispatch-pending "$mode"
