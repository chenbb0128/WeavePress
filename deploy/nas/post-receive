#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
set +x

readonly MASTER_REF="refs/heads/master"
readonly SERVER_BASELINE_REF="refs/weavepress/last-processed-server"
readonly GATEWAY_BASELINE_REF="refs/weavepress/last-processed-gateway"
readonly ZERO_SHA="0000000000000000000000000000000000000000"
readonly JENKINS_REQUEST_MAX_SECONDS=20
readonly TRIGGER_ATTEMPTS=3
readonly TRIGGER_RETRY_DELAY_SECONDS=2
readonly LOCK_WAIT_SECONDS=180
readonly JENKINS_URL="http://127.0.0.1:18080"
readonly ENABLE_FILE="/volume1/docker/weavepress-git/.enable-auto-deploy"
readonly SECRETS_DIR="/volume1/docker/weavepress-git/.secrets"
readonly LOG_FILE="/volume1/docker/weavepress-git/post-receive.log"
readonly LOCK_FILE="/volume1/docker/weavepress-git/post-receive.lock"
readonly SERVER_JOB="WeavePress/WeavePressServer"
readonly GATEWAY_JOB="WeavePress/WeavePressGateway"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

die() {
  log "ERROR: $1"
  exit 1
}

read_secret() {
  local path="$1"
  local label="$2"
  local value=""
  local extra=""

  [[ -f "$path" && -r "$path" ]] || die "$label credential file is not readable"
  {
    IFS= read -r value || [[ -n "$value" ]]
    if IFS= read -r extra; then
      die "$label credential file must contain exactly one line"
    fi
  } < "$path"
  [[ -n "$value" ]] || die "$label credential is empty"
  if LC_ALL=C grep -q '[[:cntrl:]]' < <(printf '%s' "$value"); then
    die "$label credential contains a control character"
  fi
  printf '%s' "$value"
}

curl_config_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

trigger_job() (
  local job_path="$1"
  local app_sha="$2"
  local folder="${job_path%%/*}"
  local job="${job_path#*/}"
  local user token escaped_user escaped_token http_code header_line header_name header_value location queue_path
  local curl_config=""
  local curl_headers=""
  local -a locations=()

  cleanup_trigger() {
    user=""
    token=""
    escaped_user=""
    escaped_token=""
    [[ -z "$curl_config" ]] || rm -f -- "$curl_config"
    [[ -z "$curl_headers" ]] || rm -f -- "$curl_headers"
  }
  trap cleanup_trigger EXIT

  user="$(read_secret "$SECRETS_DIR/zdzq-hook-user" 'Jenkins user')" || return 1
  token="$(read_secret "$SECRETS_DIR/zdzq-hook-token" 'Jenkins token')" || return 1
  curl_config="$(mktemp "${TMPDIR:-/tmp}/weavepress-hook-curl.config.XXXXXX")" || \
    die 'could not allocate Jenkins curl config'
  curl_headers="$(mktemp "${TMPDIR:-/tmp}/weavepress-hook-curl.headers.XXXXXX")" || \
    die 'could not allocate Jenkins response headers'
  chmod 0600 "$curl_config" "$curl_headers"
  escaped_user="$(curl_config_escape "$user")"
  escaped_token="$(curl_config_escape "$token")"
  printf 'user = "%s:%s"\n' "$escaped_user" "$escaped_token" > "$curl_config"
  user=""
  token=""
  escaped_user=""
  escaped_token=""

  if ! http_code="$(curl --config "$curl_config" \
    --noproxy '*' --silent --show-error \
    --request POST \
    --max-redirs 0 \
    --connect-timeout 5 \
    --max-time "$JENKINS_REQUEST_MAX_SECONDS" \
    --dump-header "$curl_headers" \
    --output /dev/null \
    --write-out '%{http_code}' \
    --data-urlencode "BRANCH=master" \
    --data-urlencode "APP_SHA=${app_sha}" \
    --data-urlencode "PUSH_ACR=true" \
    --data-urlencode "DEPLOY=true" \
    --data-urlencode "TRIGGER_REPO=nas-hook" \
    "${JENKINS_URL}/job/${folder}/job/${job}/buildWithParameters")"; then
    die "Jenkins dispatch failed for ${job_path} at ${app_sha}"
  fi
  [[ "$http_code" == 201 ]] || \
    die "Jenkins dispatch returned HTTP ${http_code} for ${job_path} at ${app_sha}"

  while IFS= read -r header_line; do
    header_line="${header_line%$'\r'}"
    [[ "$header_line" == *:* ]] || continue
    header_name="${header_line%%:*}"
    [[ "${header_name,,}" == location ]] || continue
    header_value="${header_line#*:}"
    header_value="${header_value#"${header_value%%[![:space:]]*}"}"
    header_value="${header_value%"${header_value##*[![:space:]]}"}"
    locations+=("$header_value")
  done < "$curl_headers"
  [[ "${#locations[@]}" -eq 1 ]] || \
    die "Jenkins response must contain exactly one Location header for ${job_path} at ${app_sha}"
  location="${locations[0]}"
  if [[ "$location" == "$JENKINS_URL/"* ]]; then
    queue_path="/${location#"$JENKINS_URL/"}"
  else
    queue_path="$location"
  fi
  [[ "$queue_path" =~ ^/queue/item/[0-9]+/$ ]] || \
    die "Jenkins response contained an invalid Location header for ${job_path} at ${app_sha}"
  log "Dispatched ${job_path} at ${app_sha}"
)

trigger_job_with_retry() {
  local job_path="$1"
  local app_sha="$2"
  local attempt=1

  while [[ "$attempt" -le "$TRIGGER_ATTEMPTS" ]]; do
    if trigger_job "$job_path" "$app_sha"; then
      return 0
    fi
    if [[ "$attempt" -lt "$TRIGGER_ATTEMPTS" ]]; then
      log "Retrying ${job_path} at ${app_sha} after failed attempt ${attempt}/${TRIGGER_ATTEMPTS}"
      sleep "$TRIGGER_RETRY_DELAY_SECONDS"
    fi
    attempt=$((attempt + 1))
  done

  log "PENDING: ${job_path} at ${app_sha} after ${TRIGGER_ATTEMPTS} failed attempts"
  return 1
}

master_seen=false
oldrev=""
newrev=""

while read -r received_old received_new received_ref extra; do
  [[ "$received_ref" == "$MASTER_REF" ]] || continue
  [[ -z "${extra:-}" ]] || die 'malformed receive record for master'
  [[ "$master_seen" == false ]] || die 'duplicate master receive record'
  master_seen=true
  oldrev="$received_old"
  newrev="$received_new"
done

[[ "$master_seen" == true ]] || exit 0
[[ "$oldrev" == "$ZERO_SHA" || "$oldrev" =~ ^[0-9a-f]{40}$ ]] || \
  die 'invalid old revision for master'
[[ "$newrev" =~ ^[0-9a-f]{40}$ ]] || die 'master deletion or invalid new revision is not deployable'
git cat-file -e "${newrev}^{commit}" 2>/dev/null || die 'new master revision is not a commit'
if [[ "$oldrev" != "$ZERO_SHA" ]]; then
  git cat-file -e "${oldrev}^{commit}" 2>/dev/null || die 'old master revision is not a commit'
fi

exec 9>>"$LOCK_FILE"
flock -w "$LOCK_WAIT_SECONDS" 9 || die 'another WeavePress post-receive hook still holds the lock'
live_master="$(git rev-parse --verify "$MASTER_REF" 2>/dev/null)" || \
  die 'could not resolve live master revision'
[[ "$live_master" =~ ^[0-9a-f]{40}$ ]] || die 'live master revision is invalid'
git cat-file -e "${live_master}^{commit}" 2>/dev/null || die 'live master revision is not a commit'

resolve_component_baseline() {
  local baseline_ref="$1"
  local candidate=""

  resolved_baseline="$ZERO_SHA"
  if candidate="$(git rev-parse --verify "$baseline_ref" 2>/dev/null)"; then
    [[ "$candidate" =~ ^[0-9a-f]{40}$ ]] || die 'stored component processing baseline is invalid'
    git cat-file -e "${candidate}^{commit}" 2>/dev/null || \
      die 'stored component processing baseline is not a commit'
    resolved_baseline="$candidate"
  fi
}

advance_component_baseline() {
  local baseline_ref="$1"
  local baseline_expected="$2"
  local live_master="$3"

  git update-ref "$baseline_ref" "$live_master" "$baseline_expected" || \
    die 'could not atomically advance a component processing baseline'
}

component_has_changes() {
  local component="$1"
  local baseline="$2"
  local target="$3"
  local changed_paths_file path
  local component_changed=false

  changed_paths_file="$(mktemp)" || die 'could not allocate changed-path buffer'
  if [[ "$baseline" =~ ^0{40}$ ]]; then
    git ls-tree -r -z --name-only "$target" -- > "$changed_paths_file" || {
      rm -f -- "$changed_paths_file"
      die 'could not enumerate initial master tree'
    }
  else
    git diff --no-renames --name-only -z "$baseline" "$target" -- > "$changed_paths_file" || {
      rm -f -- "$changed_paths_file"
      die 'could not derive accumulated component paths'
    }
  fi

  while IFS= read -r -d '' path; do
    case "$component:$path" in
      server:server/*|server:deploy/production/*|server:deploy/jenkins/assert-component-current.sh|server:deploy/jenkins/publish-immutable-image.sh)
        component_changed=true
        ;;
      gateway:admin/*|gateway:web/*|gateway:.dockerignore|gateway:deploy/Dockerfile.gateway|gateway:deploy/Dockerfile.gateway.dockerignore|gateway:deploy/nginx.conf|gateway:deploy/jenkins/assert-component-current.sh|gateway:deploy/jenkins/publish-immutable-image.sh|gateway:deploy/jenkins/verify-gateway-release.sh)
        component_changed=true
        ;;
    esac
  done < "$changed_paths_file"
  rm -f -- "$changed_paths_file"
  [[ "$component_changed" == true ]]
}

process_component() {
  local component="$1"
  local job_path="$2"
  local baseline_ref="$3"
  local baseline

  resolve_component_baseline "$baseline_ref"
  baseline="$resolved_baseline"
  if [[ "$baseline" == "$live_master" ]]; then
    log "${component} at ${live_master} is already processed"
    return 0
  fi

  if ! component_has_changes "$component" "$baseline" "$live_master"; then
    advance_component_baseline "$baseline_ref" "$baseline" "$live_master"
    log "Processed ${component} baseline at ${live_master}; no matching paths changed"
    return 0
  fi

  if trigger_job_with_retry "$job_path" "$live_master"; then
    advance_component_baseline "$baseline_ref" "$baseline" "$live_master"
    return 0
  fi
  return 1
}

if [[ "$newrev" != "$live_master" ]]; then
  log "Coalescing stale master receive at ${newrev} into live master ${live_master}"
fi

if [[ ! -f "$ENABLE_FILE" ]]; then
  resolve_component_baseline "$SERVER_BASELINE_REF"
  server_baseline="$resolved_baseline"
  resolve_component_baseline "$GATEWAY_BASELINE_REF"
  gateway_baseline="$resolved_baseline"
  advance_component_baseline "$SERVER_BASELINE_REF" "$server_baseline" "$live_master"
  advance_component_baseline "$GATEWAY_BASELINE_REF" "$gateway_baseline" "$live_master"
  log "Mirrored master at ${live_master}; synchronized manual-release baselines while automatic deployment remains disabled"
  exit 0
fi

processing_failed=false
if process_component server "$SERVER_JOB" "$SERVER_BASELINE_REF"; then
  :
else
  processing_failed=true
fi
if process_component gateway "$GATEWAY_JOB" "$GATEWAY_BASELINE_REF"; then
  :
else
  processing_failed=true
fi
[[ "$processing_failed" == false ]] || exit 1
