#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
set +x

readonly DB_NAME="weavepress"
readonly APP_DB_USER="weavepress_app"
readonly MIGRATOR_DB_USER="weavepress_migrator"
readonly APP_DIR="${WEAVEPRESS_APP_DIR:-/opt/apps/weavepress}"
readonly ENV_FILE="$APP_DIR/.env"
readonly ENV_EXAMPLE="$APP_DIR/.env.example"
readonly COMPOSE_FILE="$APP_DIR/compose.yaml"
readonly LOCK_FILE="${WEAVEPRESS_LOCK_FILE:-/var/lock/weavepress-initialize.lock}"

die() {
  printf 'initialize-weavepress: %s\n' "$1" >&2
  exit 1
}

[[ "${EUID:-$(id -u)}" -eq 0 ]] || die 'must run as root'
[[ -d "$APP_DIR" ]] || die "$APP_DIR is missing"
[[ ! -e "$ENV_FILE" ]] || die "$ENV_FILE already exists; initialization is one-time only"
[[ -f "$ENV_EXAMPLE" ]] || die "$ENV_EXAMPLE is missing"
[[ -f "$COMPOSE_FILE" ]] || die "$COMPOSE_FILE is missing"

exec 9>"$LOCK_FILE"
flock -w 1800 9 || die 'another WeavePress initialization still holds the lock'
[[ ! -e "$ENV_FILE" ]] || die "$ENV_FILE appeared while waiting for the initialization lock"

redis_size="$(docker exec redis sh -c 'REDISCLI_AUTH="${REDISCLI_AUTH:-${REDIS_PASSWORD:-}}" redis-cli -n 7 DBSIZE' 2>/dev/null)" || \
  die 'could not inspect Redis DB 7'
[[ "$redis_size" == "0" ]] || die 'Redis DB 7 is not empty'

mysql_scalar() {
  docker exec mysql sh -c \
    'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql --batch --skip-column-names --user=root --execute="$1"' \
    sh "$1" 2>/dev/null
}

schema_count="$(mysql_scalar "SELECT COUNT(*) FROM INFORMATION_SCHEMA.SCHEMATA WHERE SCHEMA_NAME='weavepress';")" || \
  die 'could not inspect MySQL schemas'
[[ "$schema_count" == "0" ]] || die 'weavepress already exists in MySQL'
app_user_count="$(mysql_scalar "SELECT COUNT(*) FROM mysql.user WHERE User='weavepress_app' AND Host='%';")" || \
  die 'could not inspect the WeavePress application user'
[[ "$app_user_count" == "0" ]] || die 'weavepress_app@% already exists in MySQL'
migrator_user_count="$(mysql_scalar "SELECT COUNT(*) FROM mysql.user WHERE User='weavepress_migrator' AND Host='%';")" || \
  die 'could not inspect the WeavePress migrator user'
[[ "$migrator_user_count" == "0" ]] || die 'weavepress_migrator@% already exists in MySQL'

expected_keys=(
  WEAVEPRESS_DB_APP_DSN
  WEAVEPRESS_DB_MIGRATION_DSN
  WEAVEPRESS_REDIS_PASSWORD
  WEAVEPRESS_AUTH_JWT_SECRET
  WEAVEPRESS_AUTH_MEDIA_SIGNING_KEY
  WEAVEPRESS_APP_ENV
  WEAVEPRESS_STORAGE_DRIVER
  WEAVEPRESS_STORAGE_QINIU_ACCESS_KEY
  WEAVEPRESS_STORAGE_QINIU_SECRET_KEY
  WEAVEPRESS_STORAGE_QINIU_BUCKET
  WEAVEPRESS_STORAGE_QINIU_DOMAIN
  WEAVEPRESS_WECHAT_ENABLED
  WEAVEPRESS_WECHAT_APP_ID
  WEAVEPRESS_WECHAT_APP_SECRET
)
mapfile -t example_keys < <(awk -F= '/^[A-Za-z_][A-Za-z0-9_]*=/ { print $1 }' "$ENV_EXAMPLE")
[[ "${example_keys[*]}" == "${expected_keys[*]}" ]] || die '.env.example keys do not match the production contract'

env_stage=""
compose_error=""
created_schema=0
created_app_user=0
created_migrator_user=0
initialization_complete=0

mysql_execute() {
  printf '%s\n' "$1" | docker exec -i mysql sh -c \
    'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql --user=root' >/dev/null 2>&1
}

compensate_database_objects() {
  local failed=0
  if [[ "$created_migrator_user" -eq 1 ]]; then
    mysql_execute "DROP USER IF EXISTS '$MIGRATOR_DB_USER'@'%';" || {
      printf 'initialize-weavepress: WARNING: failed to compensate migrator user; manual cleanup is required\n' >&2
      failed=1
    }
  fi
  if [[ "$created_app_user" -eq 1 ]]; then
    mysql_execute "DROP USER IF EXISTS '$APP_DB_USER'@'%';" || {
      printf 'initialize-weavepress: WARNING: failed to compensate application user; manual cleanup is required\n' >&2
      failed=1
    }
  fi
  if [[ "$created_schema" -eq 1 ]]; then
    mysql_execute "DROP DATABASE IF EXISTS \`$DB_NAME\`;" || {
      printf 'initialize-weavepress: WARNING: failed to compensate database schema; manual cleanup is required\n' >&2
      failed=1
    }
  fi
  [[ "$failed" -eq 0 ]] || printf 'initialize-weavepress: WARNING: initialization compensation is incomplete\n' >&2
}

cleanup() {
  local status=$?
  trap - EXIT
  if [[ "$initialization_complete" -eq 0 && -n "$env_stage" && -e "$ENV_FILE" && "$ENV_FILE" -ef "$env_stage" ]]; then
    initialization_complete=1
  fi
  if [[ -n "$compose_error" ]]; then
    rm -f -- "$compose_error" || printf 'initialize-weavepress: WARNING: failed to remove Compose diagnostic temp file\n' >&2
  fi
  if [[ -n "$env_stage" ]]; then
    rm -f -- "$env_stage" || printf 'initialize-weavepress: WARNING: failed to remove environment staging link\n' >&2
  fi
  if [[ "$status" -ne 0 && "$initialization_complete" -eq 0 ]]; then
    compensate_database_objects
  fi
  exit "$status"
}
trap cleanup EXIT

app_password="$(openssl rand -hex 32)"
migrator_password="$(openssl rand -hex 32)"
jwt_secret="$(openssl rand -hex 32)"
media_signing_key="$(openssl rand -hex 32)"
for generated_secret in "$app_password" "$migrator_password" "$jwt_secret" "$media_signing_key"; do
  [[ "$generated_secret" =~ ^[0-9a-f]{64}$ ]] || die 'openssl returned an invalid generated secret'
done
redis_password="$(docker exec redis sh -c 'printf %s "${REDISCLI_AUTH:-${REDIS_PASSWORD:-}}"')" || \
  die 'could not read the shared Redis credential'
[[ "$redis_password" =~ ^[A-Za-z0-9._~!@%+,/:=-]{1,512}$ ]] || \
  die 'shared Redis credential is empty or outside the production allowlist'

env_stage="$(mktemp "$APP_DIR/.env.initialize.XXXXXX")"
{
  printf 'WEAVEPRESS_DB_APP_DSN=%s:%s@tcp(mysql:3306)/%s\n' "$APP_DB_USER" "$app_password" "$DB_NAME"
  printf 'WEAVEPRESS_DB_MIGRATION_DSN=%s:%s@tcp(mysql:3306)/%s\n' "$MIGRATOR_DB_USER" "$migrator_password" "$DB_NAME"
  printf "WEAVEPRESS_REDIS_PASSWORD='%s'\n" "$redis_password"
  printf 'WEAVEPRESS_AUTH_JWT_SECRET=%s\n' "$jwt_secret"
  printf 'WEAVEPRESS_AUTH_MEDIA_SIGNING_KEY=%s\n' "$media_signing_key"
  printf 'WEAVEPRESS_APP_ENV=staging\n'
  printf 'WEAVEPRESS_STORAGE_DRIVER=local\n'
  printf 'WEAVEPRESS_STORAGE_QINIU_ACCESS_KEY=\n'
  printf 'WEAVEPRESS_STORAGE_QINIU_SECRET_KEY=\n'
  printf 'WEAVEPRESS_STORAGE_QINIU_BUCKET=\n'
  printf 'WEAVEPRESS_STORAGE_QINIU_DOMAIN=\n'
  printf 'WEAVEPRESS_WECHAT_ENABLED=false\n'
  printf 'WEAVEPRESS_WECHAT_APP_ID=\n'
  printf 'WEAVEPRESS_WECHAT_APP_SECRET=\n'
} > "$env_stage"
chown root:root "$env_stage"
chmod 0600 "$env_stage"

mapfile -t generated_keys < <(awk -F= '/^[A-Za-z_][A-Za-z0-9_]*=/ { print $1 }' "$env_stage")
[[ "${generated_keys[*]}" == "${expected_keys[*]}" ]] || die 'generated .env keys are incomplete'

compose_error="$(mktemp "$APP_DIR/.compose-initialize-error.XXXXXX")"
if ! APP_SHA=0000000000000000000000000000000000000000 \
  docker compose --env-file "$env_stage" -f "$COMPOSE_FILE" config --quiet \
  >/dev/null 2>"$compose_error"; then
  die 'staged production environment failed Compose validation; diagnostic output was suppressed'
fi
rm -f -- "$compose_error"
compose_error=""
[[ ! -e "$ENV_FILE" ]] || die "$ENV_FILE appeared before database initialization; refusing to continue"

mysql_execute "CREATE DATABASE \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;" || \
  die 'failed to create the WeavePress database schema'
created_schema=1
mysql_execute "CREATE USER '$APP_DB_USER'@'%' IDENTIFIED BY '$app_password';" || \
  die 'failed to create the application database user'
created_app_user=1
mysql_execute "GRANT SELECT, INSERT, UPDATE, DELETE ON \`$DB_NAME\`.* TO '$APP_DB_USER'@'%';" || \
  die 'failed to grant the application database user'
mysql_execute "CREATE USER '$MIGRATOR_DB_USER'@'%' IDENTIFIED BY '$migrator_password';" || \
  die 'failed to create the migrator database user'
created_migrator_user=1
mysql_execute "GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, REFERENCES, CREATE TEMPORARY TABLES, LOCK TABLES ON \`$DB_NAME\`.* TO '$MIGRATOR_DB_USER'@'%';" || \
  die 'failed to grant the migrator database user'

mkdir -p "$APP_DIR/data/media" "$APP_DIR/backup/mysql" "$APP_DIR/backup/env"
chown 65532:65532 "$APP_DIR/data/media"

ln "$env_stage" "$ENV_FILE" || die "$ENV_FILE appeared during initialization; refusing to overwrite it"
initialization_complete=1
if rm -f -- "$env_stage"; then
  env_stage=""
else
  printf 'initialize-weavepress: WARNING: failed to remove environment staging link\n' >&2
fi

printf 'WeavePress initialization completed. Secrets were written to %s and were not displayed.\n' "$ENV_FILE"
