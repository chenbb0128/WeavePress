#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly APP_DIR="${WEAVEPRESS_APP_DIR:-/opt/apps/weavepress}"
readonly ENV_FILE="$APP_DIR/.env"
readonly ENV_EXAMPLE="$APP_DIR/.env.example"
readonly COMPOSE_FILE="$APP_DIR/compose.yaml"
readonly ENV_BACKUP_DIR="$APP_DIR/backup/env"
readonly METADATA_DIR="${WEAVEPRESS_METADATA_DIR:-/var/lib/zdzq-deploy/weavepress}"

die() {
  printf 'weavepress-external-secrets-install: %s\n' "$1" >&2
  exit 1
}

[[ "${EUID:-$(id -u)}" -eq 0 ]] || die 'must run as root'
[[ -t 0 && -t 1 ]] || die 'stdin and stdout must both be an interactive terminal'
[[ -f "$ENV_FILE" && -f "$ENV_EXAMPLE" && -f "$COMPOSE_FILE" ]] || die 'production Compose or environment files are missing'

read -rsp 'Qiniu access key: ' qiniu_access_key; printf '\n'
read -rsp 'Qiniu secret key: ' qiniu_secret_key; printf '\n'
read -rsp 'Qiniu bucket: ' qiniu_bucket; printf '\n'
read -rsp 'Qiniu domain (https://...): ' qiniu_domain; printf '\n'
read -rsp 'WeChat AppID (optional): ' wechat_app_id; printf '\n'
read -rsp 'WeChat AppSecret (optional): ' wechat_app_secret; printf '\n'

[[ -n "$qiniu_access_key" && -n "$qiniu_secret_key" && -n "$qiniu_bucket" && -n "$qiniu_domain" ]] || \
  die 'all four Qiniu values are required'
if [[ -n "$wechat_app_id" && -z "$wechat_app_secret" ]] || [[ -z "$wechat_app_id" && -n "$wechat_app_secret" ]]; then
  die 'WeChat AppID and AppSecret must both be provided or both be empty'
fi

for value in "$qiniu_access_key" "$qiniu_secret_key" "$qiniu_bucket" "$qiniu_domain" "$wechat_app_id" "$wechat_app_secret"; do
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die 'a credential contains a control character'
done

expected_keys=(
  WEAVEPRESS_DB_APP_DSN
  WEAVEPRESS_DB_MIGRATION_DSN
  WEAVEPRESS_REDIS_PASSWORD
  WEAVEPRESS_AUTH_JWT_SECRET
  WEAVEPRESS_AUTH_MEDIA_SIGNING_KEY
  WEAVEPRESS_APP_ENV
  WEAVEPRESS_STORAGE_DRIVER
  WEAVEPRESS_STORAGE_QINIU_ACCESS_KEY
  WEAVEPRESS_STORAGE_QINIU_SECRET_KEY
  WEAVEPRESS_STORAGE_QINIU_BUCKET
  WEAVEPRESS_STORAGE_QINIU_DOMAIN
  WEAVEPRESS_WECHAT_ENABLED
  WEAVEPRESS_WECHAT_APP_ID
  WEAVEPRESS_WECHAT_APP_SECRET
)
mapfile -t example_keys < <(awk -F= '/^[A-Z0-9_]+=/ { print $1 }' "$ENV_EXAMPLE")
mapfile -t current_keys < <(awk -F= '/^[A-Z0-9_]+=/ { print $1 }' "$ENV_FILE")
[[ "${example_keys[*]}" == "${expected_keys[*]}" ]] || die '.env.example keys do not match the production contract'
[[ "${current_keys[*]}" == "${expected_keys[*]}" ]] || die 'current .env keys do not match the production contract'

env_line() {
  local key="$1"
  local count
  count="$(grep -c "^${key}=" "$ENV_FILE")"
  [[ "$count" -eq 1 ]] || die "current .env must contain exactly one $key"
  grep -m1 "^${key}=" "$ENV_FILE"
}

write_dotenv_value() {
  local key="$1"
  local value="$2"
  value="${value//\'/\\\'}"
  printf "%s='%s'\n" "$key" "$value"
}

mkdir -p "$ENV_BACKUP_DIR"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup_file="$(mktemp "$ENV_BACKUP_DIR/.env.$timestamp.XXXXXX")"
install -o root -g root -m 0600 "$ENV_FILE" "$backup_file"

env_temp="$(mktemp "$APP_DIR/.env.external.XXXXXX")"
cleanup() {
  [[ -z "$env_temp" ]] || rm -f -- "$env_temp"
}
trap cleanup EXIT

{
  env_line WEAVEPRESS_DB_APP_DSN
  env_line WEAVEPRESS_DB_MIGRATION_DSN
  env_line WEAVEPRESS_REDIS_PASSWORD
  env_line WEAVEPRESS_AUTH_JWT_SECRET
  env_line WEAVEPRESS_AUTH_MEDIA_SIGNING_KEY
  printf 'WEAVEPRESS_APP_ENV=production\n'
  printf 'WEAVEPRESS_STORAGE_DRIVER=qiniu\n'
  write_dotenv_value WEAVEPRESS_STORAGE_QINIU_ACCESS_KEY "$qiniu_access_key"
  write_dotenv_value WEAVEPRESS_STORAGE_QINIU_SECRET_KEY "$qiniu_secret_key"
  write_dotenv_value WEAVEPRESS_STORAGE_QINIU_BUCKET "$qiniu_bucket"
  write_dotenv_value WEAVEPRESS_STORAGE_QINIU_DOMAIN "$qiniu_domain"
  if [[ -n "$wechat_app_id" ]]; then
    printf 'WEAVEPRESS_WECHAT_ENABLED=true\n'
  else
    printf 'WEAVEPRESS_WECHAT_ENABLED=false\n'
  fi
  write_dotenv_value WEAVEPRESS_WECHAT_APP_ID "$wechat_app_id"
  write_dotenv_value WEAVEPRESS_WECHAT_APP_SECRET "$wechat_app_secret"
} > "$env_temp"

mapfile -t generated_keys < <(awk -F= '/^[A-Z0-9_]+=/ { print $1 }' "$env_temp")
[[ "${generated_keys[*]}" == "${expected_keys[*]}" ]] || die 'generated .env keys are incomplete'

app_sha="0000000000000000000000000000000000000000"
for metadata_file in "$METADATA_DIR/server.env" "$METADATA_DIR/gateway.env"; do
  if [[ -f "$metadata_file" ]]; then
    metadata_sha="$(awk -F= '/^APP_SHA=[0-9a-f]{40}$/ { print $2; exit }' "$metadata_file")"
    if [[ "$metadata_sha" =~ ^[0-9a-f]{40}$ ]]; then
      app_sha="$metadata_sha"
      break
    fi
  fi
done

APP_SHA="$app_sha" docker compose --env-file "$env_temp" -f "$COMPOSE_FILE" config --quiet
chown root:root "$env_temp"
chmod 0600 "$env_temp"
mv -T -- "$env_temp" "$ENV_FILE"
env_temp=""

printf 'External credentials were installed after Compose validation. Review the backup at %s, then run an explicit Server deployment; no service was restarted.\n' "$backup_file"
