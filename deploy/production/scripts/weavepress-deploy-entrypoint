#!/usr/bin/env bash
set -Eeuo pipefail

die() {
  printf 'weavepress-deploy-entrypoint: rejected command\n' >&2
  exit 64
}

[[ $# -eq 0 ]] || die
[[ -n "${SSH_ORIGINAL_COMMAND+x}" && -n "$SSH_ORIGINAL_COMMAND" ]] || die
if printf '%s' "$SSH_ORIGINAL_COMMAND" | LC_ALL=C grep -q '[[:cntrl:]]'; then
  die
fi

if [[ "$SSH_ORIGINAL_COMMAND" =~ ^([0-9a-f]{40})\ --component=(server|gateway)$ ]]; then
  app_sha="${BASH_REMATCH[1]}"
  component="${BASH_REMATCH[2]}"
else
  die
fi
[[ "$app_sha" =~ ^[0-9a-f]{40}$ ]] || die

exec /usr/bin/sudo -n /usr/local/sbin/deploy-weavepress "$app_sha" "--component=$component"
