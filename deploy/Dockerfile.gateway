# syntax=docker/dockerfile:1
FROM node:24-alpine AS admin-build
RUN corepack enable
WORKDIR /src/admin
COPY admin/package.json admin/pnpm-lock.yaml admin/pnpm-workspace.yaml ./
COPY admin/internal ./internal
COPY admin/packages ./packages
COPY admin/scripts ./scripts
COPY admin/apps ./apps
COPY admin/*.mjs admin/*.ts admin/*.json admin/.npmrc admin/.browserslistrc admin/.stylelintignore ./
RUN pnpm install --frozen-lockfile && pnpm build

FROM node:24-alpine AS web-build
RUN corepack enable
WORKDIR /src/web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web .
RUN pnpm generate

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=admin-build /src/admin/apps/web-ele/dist /usr/share/nginx/html/admin
COPY --from=web-build /src/web/.output/public /usr/share/nginx/html
EXPOSE 80
