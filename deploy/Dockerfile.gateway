# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS admin-build
RUN corepack enable
WORKDIR /src/admin
COPY admin/package.json admin/pnpm-lock.yaml admin/pnpm-workspace.yaml ./
COPY admin/internal ./internal
COPY admin/packages ./packages
COPY admin/scripts ./scripts
COPY admin/apps ./apps
COPY admin/*.mjs admin/*.ts admin/*.json admin/.npmrc admin/.browserslistrc admin/.stylelintignore ./
RUN pnpm install --frozen-lockfile && pnpm build

FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS web-build
RUN corepack enable
WORKDIR /src/web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web .
RUN pnpm generate

FROM nginx@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
ARG APP_SHA
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
RUN printf '%s' "$APP_SHA" | grep -Eq '^[0-9a-f]{40}$' \
    && sed -i "s/__WEAVEPRESS_APP_SHA__/$APP_SHA/g" /etc/nginx/conf.d/default.conf
LABEL org.opencontainers.image.revision=$APP_SHA
COPY --from=admin-build /src/admin/apps/web-ele/dist /usr/share/nginx/html/admin
COPY --from=web-build /src/web/.output/public /usr/share/nginx/html
EXPOSE 80
